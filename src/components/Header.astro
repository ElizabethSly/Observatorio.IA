---
const esInicio = Astro.url.pathname === "/";
---

<header class="site-header">
	<div class="header-inner">
		<div class="left">
			{!esInicio && (
				<button type="button" class="back-btn" data-back aria-label="Volver a la página anterior">
					← Volver
				</button>
			)}

			<a href="/" class="brand">
				<span class="brand-small">OBSERVATORIO IA + Nuclear</span>
				<span class="brand-name">IA en el sector nuclear</span>
			</a>
		</div>

		<nav>
			<a href="/">Inicio</a>
			<a href="/#explorar">Explorar</a>
			<a href="/documentos">Documentos</a>
		</nav>
	</div>
</header>

<script>
	document.querySelectorAll("[data-back]").forEach((boton) => {
		boton.addEventListener("click", () => {
			if (window.history.length > 1) {
				window.history.back();
			} else {
				window.location.href = "/";
			}
		});
	});
</script>

<style>
	.site-header {
		position: relative;
		border-bottom: 1px solid #e5e7eb;
		background: #ffffff;
	}

	.header-inner {
		max-width: 1100px;
		margin: 0 auto;
		padding: 18px 32px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 30px;
	}

	.left {
		display: flex;
		align-items: center;
		gap: 20px;
	}

	.back-btn {
		position: absolute;
		left: 20px;
		top: 50%;
		transform: translateY(-50%);
		padding: 0;
		border: none;
		background: none;
		color: #9ca3af;
		font: inherit;
		font-size: 0.8rem;
		cursor: pointer;
		white-space: nowrap;
	}

	@media (max-width: 1250px) {
		.back-btn {
			position: static;
			transform: none;
		}
	}

	.back-btn:hover {
		color: #2563EB;
	}

	.brand {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: #111111;
	}

	.brand-small {
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		color: #2563EB;
	}

	.brand-name {
		font-size: 0.95rem;
		font-weight: 600;
		margin-top: 2px;
	}

	nav {
		display: flex;
		gap: 24px;
	}

	nav a {
		color: #333333;
		text-decoration: none;
		font-size: 0.9rem;
	}

	nav a:hover {
		color: #2563EB;
	}

	@media (max-width: 650px) {
		.header-inner {
			padding: 12px 20px;
			gap: 12px;
		}

		.left {
			gap: 10px;
		}

		.brand-small {
			display: none;
		}

		nav {
			gap: 12px;
		}

		nav a {
			font-size: 0.82rem;
		}
	}
</style>