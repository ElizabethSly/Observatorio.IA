<section class="hero">
	<div class="hero-content">
		<p class="eyebrow">OBSERVATORIO</p>

		<h1>
			Inteligencia Artificial
			<span>y Regulación Nuclear</span>
		</h1>

		<p class="intro">
			Base de consulta sobre el uso de inteligencia artificial en organismos reguladores y otras instituciones
            del sector nuclear, con orientación investigativa.
		</p>

		<a href="#explorar" class="hero-link">
			Explorar el observatorio →
		</a>
	</div>
</section>

<style>
	.hero {
		border-bottom: 1px solid #e5e7eb;
	}

	.hero-content {
		max-width: 1100px;
		margin: 0 auto;
		padding: 100px 32px 110px;
	}

	.eyebrow {
		margin: 0 0 25px;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		color: #2563EB;
	}

	h1 {
		max-width: 900px;
		margin: 0;
		font-size: clamp(3rem, 7vw, 6rem);
		line-height: 0.98;
		letter-spacing: -0.04em;
		font-weight: 700;
	}

	h1 span {
		display: block;
		color: #2563EB;
	}

	.intro {
		max-width: 650px;
		margin: 35px 0 0;
		font-size: 1.15rem;
		line-height: 1.7;
		color: #555555;
	}

	.hero-link {
		display: inline-block;
		margin-top: 30px;
		padding: 13px 20px;
		background: #2563EB;
		color: #ffffff;
		text-decoration: none;
		border-radius: 4px;
		font-size: 0.9rem;
		font-weight: 600;
	}

	.hero-link:hover {
		background: #1d4ed8;
	}

	@media (max-width: 650px) {
		.hero-content {
			padding: 70px 20px 80px;
		}

		h1 {
			font-size: clamp(2.7rem, 13vw, 4rem);
		}
	}
</style>