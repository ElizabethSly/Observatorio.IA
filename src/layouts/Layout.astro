
---
import Header from "../components/Header.astro";
import SubirArriba from "../components/SubirArriba.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Observatorio de Inteligencia Artificial y Regulación Nuclear",
	description = "Espacio de exploración de avances, aplicaciones y experiencias relacionadas con la inteligencia artificial en el ámbito de la regulación nuclear.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>

	<body>
		<Header />

		<slot />
		

		<SubirArriba />
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		font-family: Arial, Helvetica, sans-serif;
		background: #ffffff;
		color: #202020;
		line-height: 1.6;
	}
	
	.regulator-type span,
	.case-tags span,
	.doc-tags span,
	.status,
	.tag,
	.meta {
		text-transform: capitalize !important;
	}
</style>