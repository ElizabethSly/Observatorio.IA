---
import Layout from "../layouts/Layout.astro";
import datos from "../data/reguladores.json";

const organismos = datos.items.filter((o) => o.tipo === "internacional");
---

<Layout>
	<main class="page">
		<header class="page-header">
			<p class="eyebrow">EXPLORAR</p>

			<h1>Organismos Internacionales</h1>

			<p class="intro">
				Organismos globales del sector.
			</p>
		</header>

		<section class="content">
			<div class="section-heading">
				<h2>Organismos</h2>
				<span>{organismos.length} registros</span>
			</div>

			{organismos.length === 0 ? (
				<p class="empty">Todavía no hay organismos internacionales cargados.</p>
			) : (
				<div class="regulator-list">
					{organismos.map((organismo) => (
						<article class="regulator">
							<div class="regulator-main">
								<p class="country">{organismo.pais}</p>
								<h3><a href={`/reguladores/${organismo.id}`}>{organismo.nombre}</a></h3>
								<p class="acronym">{organismo.sigla}</p>
								<p class="description">{organismo.descripcion}</p>
							</div>
						</article>
					))}
				</div>
			)}
		</section>
	</main>
</Layout>

<style>
	.page {
		max-width: 1100px;
		margin: 0 auto;
		padding: 80px 32px 100px;
	}

	.page-header {
		max-width: 850px;
		padding-bottom: 60px;
		border-bottom: 1px solid #e5e7eb;
	}

	.eyebrow {
		margin: 0 0 20px;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		color: #2563eb;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.8rem, 6vw, 5rem);
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.intro {
		max-width: 700px;
		margin: 30px 0 0;
		font-size: 1.15rem;
		color: #555555;
		line-height: 1.7;
	}

	.content {
		padding-top: 45px;
	}

	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 20px;
	}

	h2 {
		margin: 0;
		font-size: 1.8rem;
	}

	.section-heading span {
		color: #666;
		font-size: 0.85rem;
	}

	.empty {
		color: #777;
	}

	.regulator {
		padding: 28px 0;
		border-top: 1px solid #d1d5db;
	}

	.regulator-main {
		max-width: 750px;
	}

	.country {
		margin: 0 0 8px;
		color: #2563eb;
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.regulator h3 {
		margin: 0;
		font-size: 1.35rem;
		line-height: 1.3;
	}

	.regulator h3 a {
		color: inherit;
		text-decoration: none;
	}

	.regulator h3 a:hover {
		color: #2563eb;
	}

	.acronym {
		margin: 5px 0 12px;
		color: #666;
		font-size: 0.9rem;
		font-weight: 600;
	}

	.description {
		margin: 0;
		color: #555;
		line-height: 1.7;
	}
</style>