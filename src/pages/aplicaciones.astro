---
import Layout from "../layouts/Layout.astro";
import datos from "../data/aplicaciones.json";

const casos = datos.items;
---

<Layout>
	<main class="page">
		<header class="page-header">
			<p class="eyebrow">EXPLORAR</p>

			<h1>Aplicaciones de IA</h1>

			<p class="intro">
				Casos de utilización de inteligencia artificial en diferentes
				áreas de la actividad regulatoria nuclear.
			</p>
		</header>

		<section class="content">
			<div class="section-heading">
				<h2>Casos de aplicación</h2>
				<span>{casos.length} registros</span>
			</div>

			{casos.length === 0 ? (
				<p class="empty">Todavía no hay casos cargados.</p>
			) : (
				<div class="case-list">
					{casos.map((caso) => (
						<article class="case">
							<div class="case-main">
								<p class="organism">{caso.organismo}</p>
								<h3>{caso.titulo}</h3>
								<p class="description">{caso.descripcion}</p>
								{caso.enlace && (
									<a class="source" href={caso.enlace} target="_blank" rel="noopener noreferrer">
										Ver fuente
									</a>
								)}
							</div>

							<div class="case-tags">
								<span>{caso.area}</span>
								<span>{caso.estado}</span>
								{caso.anio && <span>{caso.anio}</span>}
							</div>
						</article>
					))}
				</div>
			)}
		</section>
	</main>
</Layout>

<style>
	.page {
		max-width: 1100px;
		margin: 0 auto;
		padding: 80px 32px 100px;
	}

	.page-header {
		max-width: 850px;
		padding-bottom: 60px;
		border-bottom: 1px solid #e5e7eb;
	}

	.eyebrow {
		margin: 0 0 20px;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		color: #2563eb;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.8rem, 6vw, 5rem);
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.intro {
		max-width: 700px;
		margin: 30px 0 0;
		font-size: 1.15rem;
		color: #555555;
		line-height: 1.7;
	}

	.content {
		padding-top: 45px;
	}

	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 20px;
	}

	h2 {
		margin: 0;
		font-size: 1.8rem;
	}

	.section-heading span {
		color: #666;
		font-size: 0.85rem;
	}

	.empty {
		color: #777;
	}

	.case {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 30px;
		padding: 28px 0;
		border-top: 1px solid #d1d5db;
	}

	.case-main {
		max-width: 750px;
	}

	.organism {
		margin: 0 0 8px;
		color: #2563eb;
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.case h3 {
		margin: 0 0 10px;
		font-size: 1.35rem;
		line-height: 1.3;
	}

	.description {
		margin: 0 0 12px;
		color: #555;
		line-height: 1.7;
	}

	.source {
		color: #2563eb;
		font-size: 0.9rem;
	}

	.case-tags {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 8px;
		max-width: 260px;
	}

	.case-tags span {
		display: inline-block;
		padding: 5px 10px;
		border: 1px solid #d1d5db;
		border-radius: 3px;
		color: #555;
		font-size: 0.78rem;
		white-space: nowrap;
	}

	@media (max-width: 650px) {
		.page {
			padding: 60px 20px 80px;
		}

		.case {
			flex-direction: column;
			gap: 15px;
		}

		.case-tags {
			justify-content: flex-start;
		}
	}
</style>