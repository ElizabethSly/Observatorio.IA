---
import Layout from "../layouts/Layout.astro";
import datos from "../data/contexto.json";

const hechos = [...datos.items].sort((a, b) =>
	String(b.fecha).localeCompare(String(a.fecha))
);

const grupos: Record<string, any[]> = {};
for (const h of hechos) {
	const anio = String(h.fecha ?? "").slice(0, 4) || "Sin fecha";
	(grupos[anio] ??= []).push(h);
}
const anios = [
	...new Set(hechos.map((h) => String(h.fecha ?? "").slice(0, 4) || "Sin fecha")),
];

function formatearFecha(fecha: string) {
	if (!fecha) return "";
	const d = new Date(`${fecha}T00:00:00`);
	return d.toLocaleDateString("es-AR", { day: "numeric", month: "long" });
}
---

<Layout>
	<main class="page">
		<header class="page-header">
			<p class="eyebrow">EXPLORAR</p>

			<h1>Contexto internacional</h1>

			<p class="intro">
				Cronología de hechos, normas, publicaciones y desarrollos
				internacionales relevantes para la inteligencia artificial en el
				ámbito nuclear.
			</p>
		</header>

		<section class="content">
			<div class="section-heading">
				<h2>Línea de tiempo</h2>
				<span>{hechos.length} registros</span>
			</div>

			{hechos.length === 0 ? (
				<p class="empty">Todavía no hay hechos cargados.</p>
			) : (
				anios.map((anio) => (
					<div class="year-block">
						<h3 class="year">{anio}</h3>

						<div class="events">
							{grupos[anio].map((h) => (
								<article class="event">
									<p class="date">
										{formatearFecha(h.fecha)}
										{h.categoria && <span class="tag">{h.categoria}</span>}
									</p>
									<h4>{h.titulo}</h4>
									{h.descripcion && <p class="description">{h.descripcion}</p>}
									{h.enlace && (
										<a class="source" href={h.enlace} target="_blank" rel="noopener noreferrer">
											Ver fuente
										</a>
									)}
								</article>
							))}
						</div>
					</div>
				))
			)}
		</section>
	</main>
</Layout>

<style>
	.page {
		max-width: 1100px;
		margin: 0 auto;
		padding: 80px 32px 100px;
	}

	.page-header {
		max-width: 850px;
		padding-bottom: 60px;
		border-bottom: 1px solid #e5e7eb;
	}

	.eyebrow {
		margin: 0 0 20px;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		color: #2563eb;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.8rem, 6vw, 5rem);
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.intro {
		max-width: 700px;
		margin: 30px 0 0;
		font-size: 1.15rem;
		color: #555555;
		line-height: 1.7;
	}

	.content {
		padding-top: 45px;
	}

	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 30px;
	}

	h2 {
		margin: 0;
		font-size: 1.8rem;
	}

	.section-heading span {
		color: #666;
		font-size: 0.85rem;
	}

	.empty {
		color: #777;
	}

	.year-block {
		display: flex;
		gap: 40px;
		padding-bottom: 20px;
	}

	.year {
		flex: 0 0 90px;
		margin: 0;
		font-size: 1.6rem;
		color: #2563eb;
	}

	.events {
		flex: 1;
		border-left: 2px solid #d1d5db;
		padding-left: 32px;
		display: flex;
		flex-direction: column;
		gap: 32px;
		padding-bottom: 20px;
	}

	.event {
		position: relative;
	}

	.event::before {
		content: "";
		position: absolute;
		left: -41px;
		top: 6px;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: #2563eb;
		border: 2px solid #ffffff;
	}

	.date {
		margin: 0 0 6px;
		color: #666;
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.tag {
		display: inline-block;
		margin-left: 10px;
		padding: 2px 8px;
		border: 1px solid #d1d5db;
		border-radius: 3px;
		color: #555;
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: none;
		letter-spacing: 0;
	}

	.event h4 {
		margin: 0 0 8px;
		font-size: 1.2rem;
		line-height: 1.3;
	}

	.description {
		margin: 0 0 10px;
		color: #555;
		line-height: 1.7;
	}

	.source {
		color: #2563eb;
		font-size: 0.9rem;
	}

	@media (max-width: 650px) {
		.page {
			padding: 60px 20px 80px;
		}

		.year-block {
			flex-direction: column;
			gap: 14px;
		}
	}
</style>