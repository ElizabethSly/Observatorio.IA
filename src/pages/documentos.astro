---
import Layout from "../layouts/Layout.astro";
import datos from "../data/reguladores.json";

const documentos = datos.items
	.flatMap((o) =>
		(o.documentos ?? []).map((d) => ({
			...d,
			organismo: o.nombre,
			sigla: o.sigla,
			organismoId: o.id,
		}))
	)
	.sort((a, b) => (b.anio ?? 0) - (a.anio ?? 0));
---

<Layout>
	<main class="page">
		<header class="page-header">
			<p class="eyebrow">EXPLORAR</p>

			<h1>Documentos</h1>

			<p class="intro">
				Informes, normas, guías, publicaciones y otros documentos de
				referencia de los organismos del observatorio.
			</p>
		</header>

		<section class="content">
			<div class="section-heading">
				<h2>Biblioteca</h2>
				<span>{documentos.length} registros</span>
			</div>

			{documentos.length === 0 ? (
				<p class="empty">Todavía no hay documentos cargados.</p>
			) : (
				<div class="doc-list">
					{documentos.map((doc) => (
						<article class="doc">
							<div class="doc-main">
								<p class="organism">
									<a href={`/reguladores/${doc.organismoId}`}>
										{doc.sigla || doc.organismo}
									</a>
								</p>
								<h3>{doc.titulo}</h3>
								<div class="links">
                            	{doc.archivo && (
		                            <a class="source" href={doc.archivo} download>
		                        	    Descargar archivo
		                            </a>
	                            )}
	                            {doc.enlace && (
	                            	<a class="source" href={doc.enlace} target="_blank" rel="noopener noreferrer">
	                        		    Abrir enlace
	                        	    </a>
                                )}
                            </div>
							</div>

							<div class="doc-tags">
								<span>{doc.tipo}</span>
								{doc.anio && <span>{doc.anio}</span>}
							</div>
						</article>
					))}
				</div>
			)}
		</section>
	</main>
</Layout>

<style>
	.page {
		max-width: 1100px;
		margin: 0 auto;
		padding: 80px 32px 100px;
	}

	.page-header {
		max-width: 850px;
		padding-bottom: 60px;
		border-bottom: 1px solid #e5e7eb;
	}

	.eyebrow {
		margin: 0 0 20px;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		color: #2563eb;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.8rem, 6vw, 5rem);
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.intro {
		max-width: 700px;
		margin: 30px 0 0;
		font-size: 1.15rem;
		color: #555555;
		line-height: 1.7;
	}

	.content {
		padding-top: 45px;
	}

	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 20px;
	}

	h2 {
		margin: 0;
		font-size: 1.8rem;
	}

	.section-heading span {
		color: #666;
		font-size: 0.85rem;
	}

	.empty {
		color: #777;
	}

	.doc {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 30px;
		padding: 28px 0;
		border-top: 1px solid #d1d5db;
	}

	.doc-main {
		max-width: 750px;
	}

	.organism {
		margin: 0 0 8px;
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.organism a {
		color: #2563eb;
		text-decoration: none;
	}

	.doc h3 {
		margin: 0 0 10px;
		font-size: 1.25rem;
		line-height: 1.3;
	}

	.source {
		color: #2563eb;
		font-size: 0.9rem;
	}

    	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 18px;
	}

	.doc-tags {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 8px;
	}

	.doc-tags span {
		display: inline-block;
		padding: 5px 10px;
		border: 1px solid #d1d5db;
		border-radius: 3px;
		color: #555;
		font-size: 0.78rem;
		white-space: nowrap;
	}

	@media (max-width: 650px) {
		.page {
			padding: 60px 20px 80px;
		}

		.doc {
			flex-direction: column;
			gap: 15px;
		}

		.doc-tags {
			justify-content: flex-start;
		}
	}
</style>