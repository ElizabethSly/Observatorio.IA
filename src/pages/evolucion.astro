---
import Layout from "../layouts/Layout.astro";
import regs from "../data/reguladores.json";
import apps from "../data/aplicaciones.json";

const eventos = [
	...regs.items.flatMap((o) =>
		(o.iniciativas ?? []).map((i) => ({
			tipo: "Iniciativa",
			anio: i.anio,
			titulo: i.titulo,
			descripcion: i.descripcion,
			estado: i.estado,
			enlace: i.enlace,
			origen: o.sigla || o.nombre,
			origenEnlace: `/reguladores/${o.id}`,
		}))
	),
	...apps.items.map((c) => ({
		tipo: "Caso de aplicación",
		anio: c.anio,
		titulo: c.titulo,
		descripcion: c.descripcion,
		estado: c.estado,
		enlace: c.enlace,
		origen: c.organismo,
		origenEnlace: null,
	})),
];

const grupos: Record<string, any[]> = {};
for (const e of eventos) {
	const clave = e.anio ? String(e.anio) : "Sin año";
	(grupos[clave] ??= []).push(e);
}

const anios = Object.keys(grupos).sort((a, b) => {
	if (a === "Sin año") return 1;
	if (b === "Sin año") return -1;
	return Number(b) - Number(a);
});
---

<Layout>
	<main class="page">
		<header class="page-header">
			<p class="eyebrow">EXPLORAR</p>

			<h1>Evolución</h1>

			<p class="intro">
				Desarrollo en el tiempo de las iniciativas y los casos de
				aplicación de inteligencia artificial en el ámbito nuclear.
			</p>
		</header>

		<section class="content">
			<div class="section-heading">
				<h2>Línea de tiempo</h2>
				<span>{eventos.length} registros</span>
			</div>

			{eventos.length === 0 ? (
				<p class="empty">Todavía no hay iniciativas ni casos cargados.</p>
			) : (
				anios.map((anio) => (
					<div class="year-block">
						<h3 class="year">{anio}</h3>

						<div class="events">
							{grupos[anio].map((e) => (
								<article class="event">
									<p class="kind">
										{e.tipo}
										{e.origen && " · "}
										{e.origen && e.origenEnlace ? (
											<a href={e.origenEnlace}>{e.origen}</a>
										) : (
											e.origen
										)}
									</p>
									<h4>{e.titulo}</h4>
									{e.estado && <p class="status">{e.estado}</p>}
									{e.descripcion && <p class="description">{e.descripcion}</p>}
									{e.enlace && (
										<a class="source" href={e.enlace} target="_blank" rel="noopener noreferrer">
											Ver fuente
										</a>
									)}
								</article>
							))}
						</div>
					</div>
				))
			)}
		</section>
	</main>
</Layout>

<style>
	.page {
		max-width: 1100px;
		margin: 0 auto;
		padding: 80px 32px 100px;
	}

	.page-header {
		max-width: 850px;
		padding-bottom: 60px;
		border-bottom: 1px solid #e5e7eb;
	}

	.eyebrow {
		margin: 0 0 20px;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		color: #2563eb;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.8rem, 6vw, 5rem);
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.intro {
		max-width: 700px;
		margin: 30px 0 0;
		font-size: 1.15rem;
		color: #555555;
		line-height: 1.7;
	}

	.content {
		padding-top: 45px;
	}

	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 20px;
	}

	h2 {
		margin: 0;
		font-size: 1.8rem;
	}

	.section-heading span {
		color: #666;
		font-size: 0.85rem;
	}

	.empty {
		color: #777;
	}

	.year-block {
		display: flex;
		gap: 40px;
		padding: 28px 0;
		border-top: 1px solid #d1d5db;
	}

	.year {
		flex: 0 0 110px;
		margin: 0;
		font-size: 1.6rem;
		color: #2563eb;
	}

	.events {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 28px;
	}

	.kind {
		margin: 0 0 6px;
		color: #666;
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.kind a {
		color: #2563eb;
		text-decoration: none;
	}

	.event h4 {
		margin: 0 0 6px;
		font-size: 1.2rem;
		line-height: 1.3;
	}

	.status {
		display: inline-block;
		margin: 0 0 10px;
		padding: 3px 9px;
		border: 1px solid #d1d5db;
		border-radius: 3px;
		color: #555;
		font-size: 0.78rem;
	}

	.description {
		margin: 0 0 10px;
		color: #555;
		line-height: 1.7;
	}

	.source {
		color: #2563eb;
		font-size: 0.9rem;
	}

	@media (max-width: 650px) {
		.page {
			padding: 60px 20px 80px;
		}

		.year-block {
			flex-direction: column;
			gap: 12px;
		}
	}
</style>